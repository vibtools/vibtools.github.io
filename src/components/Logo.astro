---
interface Props {
  compact?: boolean;
  variant?: 'lockup' | 'icon' | 'image';
  size?: 'xs' | 'sm' | 'md' | 'lg';
  badge?: string | false;
  class?: string;
}

const {
  compact = false,
  variant = compact ? 'icon' : 'lockup',
  size = 'sm',
  badge = 'HUB',
  class: className = '',
} = Astro.props;

const isIconOnly = compact || variant === 'icon';
const isRasterImage = variant === 'image';

const sizeMap = {
  xs: {
    container: 'h-6 w-6 rounded-md',
    icon: 'h-4 w-4',
    text: 'text-[13px]',
    badge: 'text-[8px] px-1 py-0.2',
  },
  sm: {
    container: 'h-7 w-7 sm:h-7.5 sm:w-7.5 rounded-lg',
    icon: 'h-4.5 w-4.5 sm:h-5 sm:w-5',
    text: 'text-[14px] sm:text-[15px]',
    badge: 'text-[9px] px-1 py-0.2',
  },
  md: {
    container: 'h-8 w-8 rounded-lg',
    icon: 'h-5.5 w-5.5',
    text: 'text-[16px] sm:text-[17px]',
    badge: 'text-[10px] px-1.5 py-0.5',
  },
  lg: {
    container: 'h-10 w-10 rounded-xl',
    icon: 'h-6.5 w-6.5',
    text: 'text-xl',
    badge: 'text-xs px-2 py-0.5',
  },
} as const;

const currentSize = sizeMap[size] || sizeMap.sm;
---

{
  isRasterImage ? (
    <img
      src="/brand/vibtools-horizontal.png"
      width={744}
      height={220}
      alt="VibTools"
      class:list={['h-auto object-contain w-36 sm:w-40', className]}
      decoding="async"
    />
  ) : isIconOnly ? (
    <img
      src="/brand/vibtools-icon.png"
      width={520}
      height={520}
      alt="VibTools"
      class:list={['h-auto object-contain', className || 'w-8']}
      decoding="async"
    />
  ) : (
    <div class:list={['inline-flex items-center gap-2 select-none', className]}>
      {/* Brand Icon Mark */}
      <div
        class:list={[
          'flex shrink-0 items-center justify-center border border-border/70 bg-surface/90 shadow-xs transition-colors group-hover:border-secondary/50',
          currentSize.container,
        ]}
      >
        <img
          src="/brand/vibtools-icon.png"
          width={520}
          height={520}
          alt=""
          class:list={[
            'object-contain transition-transform group-hover:scale-105',
            currentSize.icon,
          ]}
          decoding="async"
        />
      </div>

      {/* Brand Site Name */}
      <div class="flex items-center gap-1.5 leading-none">
        <span
          class:list={['font-sans font-bold tracking-tight text-text-primary', currentSize.text]}
        >
          Vib<span class="text-secondary font-semibold">Tools</span>
        </span>

        {badge && (
          <span
            class:list={[
              'inline-flex items-center rounded border border-border/80 bg-surface/80 font-mono font-medium tracking-wider text-text-secondary uppercase transition-colors group-hover:border-secondary/40 group-hover:text-text-primary',
              currentSize.badge,
            ]}
          >
            {badge}
          </span>
        )}
      </div>
    </div>
  )
}
