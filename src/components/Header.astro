---
import {
  Bot,
  ChevronRight,
  Download,
  FileCode,
  GitBranch,
  Menu,
  PackageOpen,
  Search,
  Sparkles,
  Terminal,
  Users,
  X,
} from '@lucide/astro';
import Logo from '@/components/Logo.astro';
import { navigation, site } from '@/config/site';
import { normalizePath } from '@/lib/urls';

const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const iconMap = {
  PackageOpen,
  Download,
  Terminal,
  FileCode,
  Sparkles,
  Users,
  Bot,
} as const;
---

<header
  class="sticky top-0 z-50 border-b border-border/80 bg-background/90 backdrop-blur-md transition-all"
>
  <div
    class="mx-auto flex h-13 sm:h-14 max-w-7xl items-center justify-between px-3.5 sm:px-6 lg:px-8"
  >
    <!-- Brand Zone -->
    <div class="flex items-center">
      <a
        href="/"
        class="group inline-flex items-center rounded-md py-1 transition-opacity hover:opacity-95 focus-visible:outline-2 focus-visible:outline-secondary"
        aria-label="VibTools Home"
      >
        <Logo size="sm" />
      </a>
    </div>

    <!-- Desktop Navigation Zone -->
    <nav aria-label="Primary navigation" class="hidden items-center gap-0.5 xl:gap-1 lg:flex">
      {
        navigation.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'inline-flex h-8 items-center rounded-md px-2.5 text-[13px] font-medium transition-all duration-150 whitespace-nowrap',
                active
                  ? 'bg-surface text-text-primary shadow-xs border border-border/70 font-semibold'
                  : 'text-text-secondary hover:bg-surface/60 hover:text-text-primary',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Utility & Action Zone -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Search Trigger (Desktop) -->
      <a
        href="/projects/?q="
        class="hidden sm:inline-flex h-8 items-center gap-2 rounded-md border border-border/70 bg-surface/60 px-2.5 text-xs text-text-secondary transition hover:border-secondary/50 hover:bg-surface hover:text-text-primary"
        title="Search projects and tools"
        aria-label="Search projects and tools"
      >
        <Search aria-hidden="true" size={13} class="text-text-secondary" />
        <span class="font-normal">Search...</span>
        <kbd
          class="ml-0.5 rounded border border-border/80 bg-background px-1 py-0.2 font-mono text-[10px] text-text-secondary"
        >
          /
        </kbd>
      </a>

      <!-- Search Trigger (Mobile Icon Only) -->
      <a
        href="/projects/?q="
        class="inline-flex sm:hidden h-8 w-8 items-center justify-center rounded-md border border-border/70 bg-surface/60 text-text-secondary transition hover:bg-surface hover:text-text-primary"
        aria-label="Search catalog"
      >
        <Search aria-hidden="true" size={15} />
      </a>

      <!-- GitHub Link -->
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-8 items-center gap-1.5 rounded-md border border-border/70 bg-surface px-2.5 text-xs font-semibold text-text-primary transition hover:border-secondary/60 hover:text-secondary shadow-xs"
        aria-label="VibTools GitHub repository"
      >
        <GitBranch aria-hidden="true" size={14} />
        <span class="hidden sm:inline">GitHub</span>
      </a>

      <!-- Mobile Navigation Hamburger Toggle -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex lg:hidden h-8 w-8 items-center justify-center rounded-md border border-border/80 bg-surface text-text-primary transition hover:border-secondary hover:text-secondary focus-visible:outline-2 focus-visible:outline-secondary active:scale-95"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <Menu
          id="mobile-menu-icon-open"
          class="shrink-0 transition-transform duration-150"
          aria-hidden="true"
          size={17}
        />
        <X
          id="mobile-menu-icon-close"
          class="shrink-0 transition-transform duration-150"
          aria-hidden="true"
          size={17}
        />
      </button>
    </div>
  </div>

  <!-- Mobile Menu Backdrop -->
  <div
    id="mobile-menu-backdrop"
    class="fixed inset-0 top-13 sm:top-14 z-40 bg-black/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-200 lg:hidden"
    aria-hidden="true"
  >
  </div>

  <!-- Mobile Menu Drawer (Slide Down) -->
  <div
    id="mobile-menu-drawer"
    class="fixed inset-x-0 top-13 sm:top-14 z-40 max-h-[calc(100vh-3.5rem)] overflow-y-auto border-b border-border bg-surface/98 backdrop-blur-xl shadow-2xl transition-all duration-200 -translate-y-2 opacity-0 pointer-events-none lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
  >
    <!-- Mobile Quick Search -->
    <div class="p-3 border-b border-border/60">
      <form action="/projects/" method="get" class="relative">
        <Search class="absolute left-3 top-2.5 text-text-secondary" size={15} />
        <input
          type="search"
          name="q"
          placeholder="Search projects, tools, downloads..."
          class="w-full rounded-md border border-border bg-background py-1.5 pl-9 pr-3 text-xs text-text-primary placeholder:text-text-secondary focus:border-secondary focus:outline-none"
        />
      </form>
    </div>

    <!-- Navigation List -->
    <nav class="p-2 space-y-1" aria-label="Mobile menu navigation">
      {
        navigation.map((item) => {
          const active = isActive(item.href);
          const IconComponent = iconMap[item.icon as keyof typeof iconMap] || PackageOpen;
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'mobile-nav-link flex items-center justify-between rounded-lg p-2.5 transition-colors',
                active
                  ? 'bg-primary/10 border border-primary/30 text-text-primary font-semibold'
                  : 'text-text-secondary hover:bg-background/80 hover:text-text-primary border border-transparent',
              ]}
            >
              <div class="flex items-center gap-3">
                <div
                  class:list={[
                    'flex h-7 w-7 items-center justify-center rounded-md border',
                    active
                      ? 'border-primary/40 bg-primary/20 text-secondary'
                      : 'border-border/60 bg-background text-text-secondary',
                  ]}
                >
                  <IconComponent size={15} />
                </div>
                <div>
                  <div
                    class:list={[
                      'text-xs font-medium',
                      active ? 'text-text-primary font-semibold' : 'text-text-primary',
                    ]}
                  >
                    {item.label}
                  </div>
                  <div class="text-[11px] text-text-secondary line-clamp-1">{item.description}</div>
                </div>
              </div>
              <ChevronRight size={14} class="text-text-secondary/50 shrink-0" />
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile Drawer Footer -->
    <div
      class="border-t border-border/60 bg-background/50 p-3 flex items-center justify-between text-xs text-text-secondary"
    >
      <div class="flex items-center gap-3">
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-text-secondary hover:text-text-primary transition"
        >
          <GitBranch size={13} />
          GitHub
        </a>
        <span>·</span>
        <a href="/about/" class="text-text-secondary hover:text-text-primary transition"> About </a>
        <span>·</span>
        <a href="/changelog/" class="text-text-secondary hover:text-text-primary transition">
          Updates
        </a>
      </div>
      <span class="font-mono text-[11px] text-text-secondary">v1.0.1</span>
    </div>
  </div>
</header>

<style>
  /* Deterministic icon toggle tied to aria-expanded - completely avoids conflicting states */
  #mobile-menu-btn[aria-expanded='false'] #mobile-menu-icon-close {
    display: none !important;
  }
  #mobile-menu-btn[aria-expanded='false'] #mobile-menu-icon-open {
    display: block !important;
  }
  #mobile-menu-btn[aria-expanded='true'] #mobile-menu-icon-close {
    display: block !important;
  }
  #mobile-menu-btn[aria-expanded='true'] #mobile-menu-icon-open {
    display: none !important;
  }
</style>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!btn || !drawer || !backdrop) return;

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      btn?.setAttribute('aria-expanded', 'true');
      btn?.setAttribute('aria-label', 'Close navigation menu');

      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100');

      drawer?.classList.remove('-translate-y-2', 'opacity-0', 'pointer-events-none');
      drawer?.classList.add('translate-y-0', 'opacity-100');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      isOpen = false;
      btn?.setAttribute('aria-expanded', 'false');
      btn?.setAttribute('aria-label', 'Open navigation menu');

      backdrop?.classList.remove('opacity-100');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');

      drawer?.classList.remove('translate-y-0', 'opacity-100');
      drawer?.classList.add('-translate-y-2', 'opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
    }

    function toggleMenu() {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    backdrop.addEventListener('click', closeMenu);

    navLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
        btn?.focus();
      }
      // Keyboard shortcut for search
      if (
        (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key === 'k')) &&
        !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)
      ) {
        e.preventDefault();
        window.location.href = '/projects/?q=';
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && isOpen) {
        closeMenu();
      }
    });
  }

  // Run on first load
  setupMobileMenu();
  // Support Astro View Transitions / re-runs if enabled
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
